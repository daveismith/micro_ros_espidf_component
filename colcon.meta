{
    "names": {
        "tracetools": {
            "cmake-args": [
                "-DTRACETOOLS_DISABLED=ON",
                "-DTRACETOOLS_STATUS_CHECKING_TOOL=OFF"
            ]
        },
        "rcl":{
            "cmake-args":[
                "-DRCL_MICROROS=ON"
            ]
        },
        "rcutils": {
            "cmake-args": [
                "-DBUILD_SHARED=OFF",
                "-DENABLE_TESTING=OFF",
                "-DRCUTILS_NO_FILESYSTEM=ON",
                "-DRCUTILS_NO_THREAD_SUPPORT=ON",
                "-DRCUTILS_NO_64_ATOMIC=OFF",
                "-DRCUTILS_AVOID_DYNAMIC_ALLOCATION=ON"
            ]
        },
        "microxrcedds_client": {
            "cmake-args": [
                "-DUCLIENT_PIC=OFF",
                "-DUCLIENT_PROFILE_DISCOVERY=ON",
                "-DUCLIENT_PROFILE_UDP=ON",
                "-DUCLIENT_PROFILE_CUSTOM_TRANSPORT=ON",
                "-DUCLIENT_PROFILE_SERIAL=OFF",
                "-DUCLIENT_PROFILE_TCP=OFF",
                "-DUCLIENT_MIN_HEARTBEAT_TIME_INTERVAL=1"
            ]
        },
        "rmw_microxrcedds": {
            "cmake-args": [
                "-DRMW_UXRCE_XML_BUFFER_LENGTH=400",
                "-DRMW_UXRCE_TRANSPORT=udp",
                "-DRMW_UXRCE_MAX_NODES=1",
                "-DRMW_UXRCE_MAX_PUBLISHERS=2",
                "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=2",
                "-DRMW_UXRCE_MAX_SERVICES=1",
                "-DRMW_UXRCE_MAX_CLIENTS=1",
                "-DRMW_UXRCE_MAX_HISTORY=1"
            ]
        },
        "embeddedrtps": {
            "cmake-args": [
                "-DERTPS_MAX_PUBLISHERS=2",
                "-DERTPS_MAX_SUBSCRIPTIONS=2",
                "-DERTPS_MAX_SERVICES=1",
                "-DERTPS_MAX_CLIENTS=1",
                "-DERTPS_MAX_HISTORY=10"
            ]
        },
        "zenohpico": {
            "cmake-args": [
                "-DZP_PLATFORM=espidf",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_TESTING=OFF",
                "-DBUILD_TOOLS=OFF",
                "-DPACKAGING=OFF",
                "-DZ_FEATURE_MULTI_THREAD=1",
                "-DZ_FEATURE_LINK_TCP=1",
                "-DZ_FEATURE_LINK_UDP_UNICAST=1",
                "-DZ_FEATURE_LINK_UDP_MULTICAST=0",
                "-DZ_FEATURE_MULTICAST_TRANSPORT=0",
                "-DZ_FEATURE_SCOUTING=0",
                "-DZ_FEATURE_LINK_SERIAL=0",
                "-DZ_FEATURE_PUBLICATION=1",
                "-DZ_FEATURE_SUBSCRIPTION=1",
                "-DZ_FEATURE_QUERY=1",
                "-DZ_FEATURE_QUERYABLE=1",
                "-DZ_FEATURE_LIVELINESS=1",
                "-DZ_FEATURE_INTEREST=1",
                "-DZ_FEATURE_FRAGMENTATION=1",
                "-DZ_FEATURE_AUTO_RECONNECT=1",
                "-DFRAG_MAX_SIZE=2048",
                "-DBATCH_UNICAST_SIZE=1024"
            ]
        },
        "rmw_zenoh_pico": {
            "cmake-args": [
                "-DWITH_ESPIDF=ON",
                "-DRMW_ZENOH_PICO_TRANSPORT_TYPE=unicast",
                "-DRMW_ZENOH_PICO_C_STANDARD=11",
                "-DBUILD_DEMO=OFF",
                "-DTESTS=OFF"
            ]
        },
        "tracetools": {
            "cmake-args": [
                "-DTRACETOOLS_DISABLED=ON",
                "-DTRACETOOLS_STATUS_CHECKING_TOOL=OFF"
            ]
        }
    }
}
